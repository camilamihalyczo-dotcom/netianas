# Copy this to .env and fill in your values
# Never commit .env to git

DATABASE_URL=postgresql://user:password@host:5432/netianas_db
PORT=3000
NODE_ENV=development

# Admin API key — protects GET/PATCH /api/sugerencias
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=your-secret-key-here

# CORS — add your Vercel URL when deployed
ALLOWED_ORIGINS=http://localhost:5500,https://netianas.vercel.app
